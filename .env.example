# Copy to .env and fill in. .env is git-ignored.

# MySQL. On the Mac: the local server (npm run mysql:start); see README.md
# "Database". Tests use TEST_DATABASE_URL and make their own databases from
# its name (tracker_test_1, tracker_test_2, ...).
DATABASE_URL=mysql://tracker:PASSWORD@127.0.0.1:3306/tracker
TEST_DATABASE_URL=mysql://tracker:PASSWORD@127.0.0.1:3306/tracker_test

AUTO_DEV_API_KEY=
MARKETCHECK_API_KEY=
OLD_CARS_DATA_API_KEY=
