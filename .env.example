# Copy to .env and fill in. .env is git-ignored.

# MySQL. On the Mac: the local server (npm run mysql:start); see README.md
# "Database". Tests use TEST_DATABASE_URL and make their own databases from
# its name (tracker_test_1, tracker_test_2, ...).
DATABASE_URL=mysql://tracker:PASSWORD@127.0.0.1:3306/tracker
TEST_DATABASE_URL=mysql://tracker:PASSWORD@127.0.0.1:3306/tracker_test

AUTO_DEV_API_KEY=
MARKETCHECK_API_KEY=
OLD_CARS_DATA_API_KEY=

# Accounts. OWNER_EMAIL's account is the owner (see README "Accounts").
# APP_URL is this site's address, for links in emails: required in production;
# a development server uses the address it was opened at.
OWNER_EMAIL=
APP_URL=
# MAX_CARS_PER_USER=5

# Customer.io (see docs/CUSTOMERIO_PLAN.md). Each part does nothing until its
# key is set. Region is read from the keys (sk_eu_…) or CUSTOMERIO_REGION.
# Browser: the JavaScript integration's write key (public, pk_…).
NEXT_PUBLIC_CUSTOMERIO_WRITE_KEY=
# Server: a Node.js integration's private key (sk_…): people and events.
CUSTOMERIO_PIPELINES_KEY=
# Transactional sign-in email: Account Settings > API Credentials (sk_…).
CUSTOMERIO_APP_API_KEY=
# The sign-in transactional message's trigger name (or ID), and optionally a
# from address (otherwise the message's own).
CUSTOMERIO_SIGNIN_MESSAGE=sign_in_link
CUSTOMERIO_FROM=
# CUSTOMERIO_REGION=us
# NEXT_PUBLIC_CUSTOMERIO_REGION=us

# CarsXE (https://api.carsxe.com): finds a side-on photo, and its wheels, for a
# car nobody has uploaded one for. One lookup (one credit) per car. Optional:
# CARSXE_LICENSE=ShareCommercially asks only for images labelled for reuse.
CARSXE_API_KEY=
# CARSXE_LICENSE=

# Car photo uploads: the background is removed with BiRefNet when it's been
# downloaded (npm run download-model; about 7 GB of memory a photo), else by
# colour and the small U²-Netp model (models/README.md). "u2netp" skips
# BiRefNet (e.g. a host short on memory); "off" uses colour alone.
# CAR_PHOTO_MODEL=u2netp
